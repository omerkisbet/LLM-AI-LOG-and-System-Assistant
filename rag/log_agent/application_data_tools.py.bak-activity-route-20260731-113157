            "activityDate"
        ),
    }


def contains_search_text(
    item: dict[str, Any],
    search_text: str,
    fields: tuple[str, ...],
) -> bool:
    needle = normalize_text(search_text)

    if not needle:
        return True

    haystack = " ".join(
        str(item.get(field) or "")
        for field in fields
    )

    return needle in normalize_text(haystack)


def select_exact_student(
    students: list[dict[str, Any]],
    search_text: str,
) -> tuple[dict[str, Any] | None, list[dict[str, Any]]]:
    normalized_search = normalize_text(
        search_text
    )

    exact_matches = [
        student
        for student in students
        if normalize_text(
            student.get("fullName")
        ) == normalized_search
    ]

    if len(exact_matches) == 1:
        return exact_matches[0], exact_matches

    if not exact_matches \
            and len(students) == 1:
        return students[0], students

    return None, exact_matches or students


def fetch_students(
    client: ApplicationDataClient,
    search_text: str | None = None,
) -> list[dict[str, Any]]:
    if search_text:
        raw = client.get(
            "/api/students/search",
            params={
                "keyword": search_text,
            },
        )
    else:
        raw = client.get(
            "/api/students"
        )

    return [
        sanitize_student(item)
        for item in (
            raw
            if isinstance(raw, list)
            else []
        )
    ]


def resolve_student(
    client: ApplicationDataClient,
    search_text: str,
) -> dict[str, Any]:
    students = fetch_students(
        client,
        search_text,
    )

    student, candidates = (
        select_exact_student(
            students,
            search_text,
        )
    )

    if student is not None:
        return {
            "resolved": True,
            "student": student,
            "candidates": [],
        }

    return {
        "resolved": False,
        "student": None,
        "candidates": candidates,
        "reason": (
            "Öğrenci bulunamadı."
            if not candidates
            else "Birden fazla öğrenci eşleşti."
        ),
    }


def student_profile(
    client: ApplicationDataClient,
    student_id: str,
    language: str,
) -> dict[str, Any]:
    raw = client.get(
        f"/api/students/{student_id}/profile"
    )

    student = sanitize_student(
        raw.get("student") or {}
    )

    return {
        "student": student,
        "statistics": raw.get(
            "statistics"
        ) or {},
        "projects": [
            sanitize_project(
                item,
                language,
            )
            for item in (
                raw.get("projects")
                or []
            )
        ],
        "publications": [
            sanitize_publication(
                item,
                language,
            )
            for item in (
                raw.get("publications")
                or []
            )
        ],
        "activities": [
            sanitize_activity(item)
            for item in (
                raw.get("activities")
                or []
            )
        ],
        "news": [
            sanitize_news(
                item,
                language,
            )
            for item in (
                raw.get("news")
                or []
            )
        ],
        "studentPeriod": raw.get(
            "studentPeriod"
        ),
        "academicianPeriod": raw.get(
            "academicianPeriod"
        ),
    }


def fetch_projects(
    client: ApplicationDataClient,
    filters: dict[str, Any],
    language: str,
    search_text: str | None,
) -> list[dict[str, Any]]:
    if filters.get("studentId"):
        path = (
            "/api/projects/student/"
            f"{filters['studentId']}"
        )
    elif filters.get("status"):
        path = (
            "/api/projects/status/"
            f"{filters['status']}"
        )
    elif filters.get("featured") is True:
        path = "/api/projects/featured"
    else:
        path = "/api/projects"

    raw = client.get(path)

    projects = [
        sanitize_project(
            item,
            language,
        )
        for item in (
            raw
            if isinstance(raw, list)
            else []
        )
    ]

    if search_text:
        projects = [
            item
            for item in projects
            if contains_search_text(
                item,
                search_text,
                (
                    "name",
                    "summary",
                    "description",
                    "technologies",
                ),
            )
        ]

    return projects


def fetch_publications(
    client: ApplicationDataClient,
    filters: dict[str, Any],
    language: str,
    search_text: str | None,
) -> list[dict[str, Any]]:
    if filters.get("studentId"):
        path = (
            "/api/publications/student/"
            f"{filters['studentId']}"
        )
        params = None
    elif filters.get("year") is not None:
        path = (
            "/api/publications/year/"
            f"{int(filters['year'])}"
        )
        params = None
    elif filters.get("type"):
        path = (
            "/api/publications/type/"
            f"{filters['type']}"
        )
        params = None
    elif filters.get("featured") is True:
        path = "/api/publications/featured"
        params = None
    elif search_text:
        path = "/api/publications/search"
        params = {
            "keyword": search_text,
        }
    else:
        path = "/api/publications"
        params = None

    raw = client.get(
        path,
        params=params,
    )

    return [
        sanitize_publication(
            item,
            language,
        )
        for item in (
            raw
            if isinstance(raw, list)
            else []
        )
    ]


