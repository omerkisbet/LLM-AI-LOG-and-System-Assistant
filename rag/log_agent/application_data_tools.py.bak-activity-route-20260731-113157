from __future__ import annotations

import os
import unicodedata
from collections import Counter
from dataclasses import dataclass
from typing import Any

import httpx


BAHTIYAR_BASE_URL = os.getenv(
    "BAHTIYAR_BASE_URL",
    "",
).strip().rstrip("/")

DEFAULT_LIMIT = 20
MAXIMUM_LIMIT = 100


class ApplicationDataToolError(RuntimeError):
    pass


@dataclass(frozen=True)
class ApplicationDataRequest:
    entity: str
    operation: str
    language: str = "tr"
    search_text: str | None = None
    record_id: str | None = None
    filters: dict[str, Any] | None = None
    group_by: str | None = None
    limit: int = DEFAULT_LIMIT


class ApplicationDataClient:

    def __init__(
        self,
        base_url: str | None = None,
        timeout_seconds: float = 20.0,
    ) -> None:
        resolved_base_url = (
            base_url
            or BAHTIYAR_BASE_URL
        ).strip().rstrip("/")

        if not resolved_base_url:
            raise ApplicationDataToolError(
                "BAHTIYAR_BASE_URL yapılandırılmamış."
            )

        self.base_url = resolved_base_url
        self.timeout = httpx.Timeout(
            timeout_seconds,
            connect=5.0,
        )

    def get(
        self,
        path: str,
        params: dict[str, Any] | None = None,
    ) -> Any:
        url = f"{self.base_url}{path}"

        try:
            with httpx.Client(
                timeout=self.timeout,
                follow_redirects=True,
            ) as client:
                response = client.get(
                    url,
                    params=params,
                    headers={
                        "Accept": "application/json",
                    },
                )
        except httpx.HTTPError as exception:
            raise ApplicationDataToolError(
                "Bahtiyar uygulama verisi API'sine "
                f"ulaşılamadı: {exception.__class__.__name__}"
            ) from exception

        if response.status_code == 404:
            raise ApplicationDataToolError(
                f"Backend endpoint bulunamadı: {path}"
            )

        if response.status_code < 200 \
                or response.status_code >= 300:
            raise ApplicationDataToolError(
                "Backend uygulama verisi API'si "
                f"HTTP {response.status_code} döndürdü."
            )

        try:
            return response.json()
        except ValueError as exception:
            raise ApplicationDataToolError(
                "Backend geçerli JSON döndürmedi."
            ) from exception


def normalize_text(value: Any) -> str:
    if value is None:
        return ""

    text = str(value).strip().lower()

    decomposed = unicodedata.normalize(
        "NFKD",
        text,
    )

    return "".join(
        character
        for character in decomposed
        if not unicodedata.combining(character)
    )


def safe_limit(value: int | None) -> int:
    if value is None:
        return DEFAULT_LIMIT

    return min(
        max(int(value), 1),
        MAXIMUM_LIMIT,
    )


def localized_value(
    item: dict[str, Any],
    language: str,
    tr_field: str,
    en_field: str,
    legacy_field: str,
) -> Any:
    preferred = (
        en_field
        if language == "en"
        else tr_field
    )

    secondary = (
        tr_field
        if language == "en"
        else en_field
    )

    return (
        item.get(preferred)
        or item.get(secondary)
        or item.get(legacy_field)
    )


def sanitize_student(
    item: dict[str, Any],
) -> dict[str, Any]:
    first_name = str(
        item.get("firstName") or ""
    ).strip()

    last_name = str(
        item.get("lastName") or ""
    ).strip()

    full_name = " ".join(
        value
        for value in (
            first_name,
            last_name,
        )
        if value
    )

    return {
        "id": item.get("id"),
        "fullName": full_name,
        "firstName": first_name or None,
        "lastName": last_name or None,
        "department": item.get("department"),
        "currentTask": item.get("currentTask"),
        "active": item.get("active"),
        "memberType": (
            item.get("memberType")
            or "STUDENT"
        ),
        "academicTitle": item.get(
            "academicTitle"
        ),
        "createdAt": item.get("createdAt"),
        "updatedAt": item.get("updatedAt"),
        "hasPhoto": bool(
            item.get("photoPath")
        ),
    }


def sanitize_project(
    item: dict[str, Any],
    language: str,
) -> dict[str, Any]:
    student_ids = list(
        item.get("studentIds")
        or []
    )

    return {
        "id": item.get("id"),
        "name": localized_value(
            item,
            language,
            "nameTr",
            "nameEn",
            "name",
        ),
        "summary": localized_value(
            item,
            language,
            "summaryTr",
            "summaryEn",
            "summary",
        ),
        "description": localized_value(
            item,
            language,
            "descriptionTr",
            "descriptionEn",
            "description",
        ),
        "startDate": item.get("startDate"),
        "endDate": item.get("endDate"),
        "status": item.get("status"),
        "technologies": list(
            item.get("technologies")
            or []
        ),
        "featured": item.get("featured"),
        "contentStatus": item.get(
            "contentStatus"
        ),
        "publishedAt": item.get(
            "publishedAt"
        ),
        "contributorCount": len(student_ids),
        "studentIds": student_ids,
    }


