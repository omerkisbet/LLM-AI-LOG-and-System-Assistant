def group_items(
    entity: str,
    items: list[dict[str, Any]],
    group_by: str | None,
) -> dict[str, int]:
    normalized_group = normalize_text(
        group_by
    )

    values: list[str] = []

    if entity in {
        "STUDENT",
        "ACADEMICIAN",
    }:
        field = (
            "department"
            if normalized_group in {
                "",
                "department",
                "bolum",
            }
            else "memberType"
        )

        values = [
            str(item.get(field) or "UNKNOWN")
            for item in items
        ]

    elif entity == "PROJECT":
        if normalized_group in {
            "technology",
            "technologies",
            "teknoloji",
            "teknolojiler",
        }:
            for item in items:
                values.extend(
                    str(value)
                    for value in (
                        item.get("technologies")
                        or []
                    )
                )
        else:
            values = [
                str(
                    item.get("status")
                    or "UNKNOWN"
                )
                for item in items
            ]

    elif entity == "PUBLICATION":
        field = (
            "publicationYear"
            if normalized_group in {
                "year",
                "yil",
            }
            else "type"
        )

        values = [
            str(item.get(field) or "UNKNOWN")
            for item in items
        ]

    elif entity == "NEWS":
        field = (
            "contentStatus"
            if normalized_group in {
                "status",
                "contentstatus",
            }
            else "category"
        )

        values = [
            str(item.get(field) or "UNKNOWN")
            for item in items
        ]

    return dict(
        Counter(values).most_common()
    )


def execute_application_data_request(
    request: ApplicationDataRequest,
    client: ApplicationDataClient | None = None,
) -> dict[str, Any]:
    data_client = (
        client
        or ApplicationDataClient()
    )

    entity = request.entity.strip().upper()
    operation = request.operation.strip().upper()
    language = (
        "en"
        if request.language == "en"
        else "tr"
    )
    filters = dict(
        request.filters
        or {}
    )
    limit = safe_limit(request.limit)

    if entity in {
        "STUDENT",
        "ACADEMICIAN",
    }:
        items = fetch_students(
            data_client,
            request.search_text
            if operation == "SEARCH"
            else None,
        )

        if entity == "ACADEMICIAN":
            items = [
                item
                for item in items
                if str(
                    item.get("memberType")
                    or ""
                ).upper() == "ACADEMICIAN"
            ]
        else:
            items = [
                item
                for item in items
                if str(
                    item.get("memberType")
                    or "STUDENT"
                ).upper() == "STUDENT"
            ]

        if "active" in filters:
            expected_active = bool(
                filters["active"]
            )

            items = [
                item
                for item in items
                if item.get("active")
                is expected_active
            ]

    elif entity == "PROJECT":
        items = fetch_projects(
            data_client,
            filters,
            language,
            request.search_text,
        )

    elif entity == "PUBLICATION":
        items = fetch_publications(
            data_client,
            filters,
            language,
            request.search_text,
        )

    elif entity == "NEWS":
        items = fetch_news(
            data_client,
            filters,
            language,
            request.search_text,
        )

    elif entity == "ACTIVITY":
        items = fetch_activities(
            data_client,
        )

        if request.search_text:
            items = [
                item
                for item in items
                if contains_search_text(
                    item,
                    request.search_text,
                    (
                        "title",
                        "description",
                    ),
                )
            ]

    elif entity == "STUDENT_PROFILE":
        student_name = (
            request.search_text
            or filters.get("studentName")
        )

        if not student_name:
            raise ApplicationDataToolError(
                "STUDENT_PROFILE için öğrenci adı gerekli."
            )

        resolution = resolve_student(
            data_client,
            str(student_name),
        )

        if not resolution["resolved"]:
            return {
                "source": "SPRING_BOOT_APPLICATION_API",
                "entity": entity,
                "operation": operation,
                "resolved": False,
                "reason": resolution.get(
                    "reason"
                ),
                "candidates": resolution.get(
                    "candidates"
                ),
            }

        student = resolution["student"]

        profile = student_profile(
            data_client,
            str(student["id"]),
            language,
        )

        return {
            "source": "SPRING_BOOT_APPLICATION_API",
            "entity": entity,
            "operation": operation,
            "resolved": True,
            "profile": profile,
        }

    elif entity == "CONTACT_MESSAGE":
        return {
            "source": "SPRING_BOOT_APPLICATION_API",
            "entity": entity,
            "operation": operation,
            "available": False,
            "reason": (
                "Contact message read endpoint has not "
                "been verified in the current backend API."
            ),
        }

    else:
        raise ApplicationDataToolError(
            f"Desteklenmeyen entity: {entity}"
        )

    total = len(items)

    if operation == "COUNT":
        return {
            "source": "SPRING_BOOT_APPLICATION_API",
            "entity": entity,
            "operation": operation,
            "count": total,
            "filters": filters,
        }

    if operation in {
        "GROUP",
        "COMPARE",
    }:
        return {
            "source": "SPRING_BOOT_APPLICATION_API",
            "entity": entity,
            "operation": operation,
            "total": total,
            "groupBy": request.group_by,
            "groups": group_items(
                entity,
                items,
                request.group_by,
            ),
        }

    if operation == "GET":
        if request.record_id:
            matched = next(
                (
                    item
                    for item in items
                    if str(
                        item.get("id")
                    ) == request.record_id
                ),
                None,
            )

            return {
                "source": "SPRING_BOOT_APPLICATION_API",
                "entity": entity,
                "operation": operation,
                "found": matched is not None,
                "item": matched,
            }

        if request.search_text:
            matched = next(
                (
                    item
                    for item in items
                    if normalize_text(
                        item.get("fullName")
                        or item.get("name")
                        or item.get("title")
                    ) == normalize_text(
                        request.search_text
                    )
                ),
                None,
            )

            return {
                "source": "SPRING_BOOT_APPLICATION_API",
                "entity": entity,
                "operation": operation,
                "found": matched is not None,
                "item": matched,
                "candidates": (
                    []
                    if matched
                    else items[:limit]
                ),
            }

    return {
        "source": "SPRING_BOOT_APPLICATION_API",
        "entity": entity,
        "operation": operation,
        "total": total,
        "returned": min(
            total,
            limit,
        ),
        "items": items[:limit],
    }
