def normalize_incident_status(
    value: str | None,
) -> str | None:
    if value is None:
        return None

    normalized = value.strip().upper()

    try:
        return IncidentStatus(normalized).value
    except ValueError as exc:
        allowed = ", ".join(
            status.value
            for status in IncidentStatus
        )
        raise HTTPException(
            status_code=400,
            detail=f"Invalid incident status. Allowed: {allowed}",
        ) from exc


