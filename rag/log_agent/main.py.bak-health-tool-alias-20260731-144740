def deterministic_operational_answer(
    plan: QueryPlan,
    operational_summary: dict[str, Any] | None,
    response_language: str,
) -> str | None:
    if operational_summary is None:
        return None

    # DETERMINISTIC_AUDIT_ANSWER_V5
    intent_name = plan.intent.value
    latest_events = list(
        operational_summary.get("latestEvents")
        or []
    )

    if intent_name == "AUDIT_LATEST":
        if not latest_events:
            if response_language == "en":
                return (
                    "No administrative audit event was found "
                    "for the selected scope."
                )

            return (
                "Seçilen kapsamda yönetici audit işlemi "
                "bulunamadı."
            )

        event = latest_events[0]

        timestamp = str(
            event.get("timestamp")
            or event.get("createdAt")
            or "unknown"
        )
        action = str(
            event.get("action")
            or "UNKNOWN"
        )
        entity = str(
            event.get("entityType")
            or event.get("entity")
            or "UNKNOWN"
        )
        actor = str(
            event.get("actor")
            or event.get("username")
            or "unknown"
        )
        ip_address = str(
            event.get("ipAddress")
            or "not recorded"
        )

        if response_language == "en":
            return (
                "Latest administrative action: "
                f"{action} on {entity}; actor={actor}; "
                f"ip={ip_address}; timestamp={timestamp}. "
                "Source: AUDIT_LOG."
            )

        return (
            "En son yönetici işlemi: "
            f"{entity} üzerinde {action}; aktör={actor}; "
            f"ip={ip_address}; zaman={timestamp}. "
            "Kaynak: AUDIT_LOG."
        )

    if intent_name == "AUDIT_DELETE_LIST":
        if not latest_events:
            if response_language == "en":
                return (
                    "No deleted audit record was found in "
                    "the selected period. Source: AUDIT_LOG."
                )

            return (
                "Seçilen dönemde silinen audit kaydı "
                "bulunamadı. Kaynak: AUDIT_LOG."
            )

        rendered_events = []

        for event in latest_events[:5]:
            timestamp = str(
                event.get("timestamp")
                or event.get("createdAt")
                or "unknown"
            )
            entity = str(
                event.get("entityType")
                or event.get("entity")
                or "UNKNOWN"
            )
            entity_id = str(
                event.get("entityId")
                or event.get("id")
                or "unknown"
            )
            actor = str(
                event.get("actor")
                or event.get("username")
                or "unknown"
            )

            rendered_events.append(
                f"{entity} id={entity_id}, "
                f"actor={actor}, timestamp={timestamp}"
            )

        separator = "; "

        if response_language == "en":
            return (
                "Deleted audit records: "
                + separator.join(rendered_events)
                + ". Source: AUDIT_LOG."
            )

        return (
            "Silinen audit kayıtları: "
            + separator.join(rendered_events)
            + ". Kaynak: AUDIT_LOG."
        )

    supported_intents = {
        QueryIntent.APPLICATION_OVERVIEW,
        QueryIntent.AUDIT_IP_SUMMARY,
        QueryIntent.AUTH_LOGIN_COUNT,
        QueryIntent.REQUEST_COUNT,
        QueryIntent.REQUEST_ENDPOINT_SUMMARY,
    }

    if plan.intent not in supported_intents:
        return None

    total_events = int(
        operational_summary.get("totalEvents", 0)
    )
    errors = int(
        operational_summary.get("errorCount", 0)
    )
    warnings = int(
        operational_summary.get("warningCount", 0)
    )
    http_requests = int(
        operational_summary.get(
            "httpRequestCount",
            0,
        )
    )
    audit_events = int(
        operational_summary.get(
            "auditLogCount",
            0,
        )
    )
    login_success = int(
        operational_summary.get(
            "loginSuccessCount",
            0,
        )
    )
    login_failure = int(
        operational_summary.get(
            "loginFailureCount",
            0,
        )
    )
    login_blocked = int(
        operational_summary.get(
            "loginBlockedCount",
            0,
        )
    )

    truncated = bool(
        operational_summary.get("truncated")
    )

    truncation_tr = (
        " Sonuç, operasyon katmanının kayıt sınırına ulaştığı için "
        "kısmi olabilir."
        if truncated
        else ""
    )
    truncation_en = (
        " The result may be partial because the operational record "
        "limit was reached."
        if truncated
        else ""
    )

    if plan.intent == QueryIntent.APPLICATION_OVERVIEW:
        top_errors = (
            operational_summary.get("topErrors")
            or []
        )

        error_text = ", ".join(
            f"{item.get('type')}: {item.get('count')}"
            for item in top_errors[:3]
        )

        if response_language == "en":
            return (
                f"In the selected period, {total_events} operational "
                f"events were reviewed. HTTP requests: {http_requests}; "
                f"audit events: {audit_events}; errors: {errors}; "
                f"warnings: {warnings}; successful admin logins: "
                f"{login_success}. Most frequent errors: "
                f"{error_text or 'none'}."
                f"{truncation_en} Sources: RUNTIME_LOG, AUDIT_LOG."
            )

        return (
            f"Seçilen dönemde {total_events} operasyon olayı incelendi. "
            f"HTTP isteği: {http_requests}; audit olayı: {audit_events}; "
            f"hata: {errors}; uyarı: {warnings}; başarılı yönetici "
            f"girişi: {login_success}. En sık hatalar: "
            f"{error_text or 'yok'}."
            f"{truncation_tr} Kaynaklar: RUNTIME_LOG, AUDIT_LOG."
        )

    if plan.intent == QueryIntent.AUDIT_IP_SUMMARY:
        ip_items = (
            operational_summary.get(
                "topIpAddresses"
            )
            or []
        )

        if not ip_items:
            if response_language == "en":
                return (
                    "No IP address was found in the audit records for "
                    "the selected period. This result covers audited "
                    "administrative events, not all website traffic. "
                    "Source: AUDIT_LOG."
                )

            return (
                "Seçilen dönemin audit kayıtlarında IP adresi "
                "bulunamadı. Bu sonuç tüm site trafiğini değil, denetlenen "
                "yönetim olaylarını kapsar. Kaynak: AUDIT_LOG."
            )

        values = ", ".join(
            f"{item.get('ipAddress')} "
            f"({item.get('count')} olay)"
            for item in ip_items
        )

        if response_language == "en":
            return (
                f"According to audit records, {len(ip_items)} distinct "
                f"IP addresses were observed: {values}. These are IPs "
                f"associated with audited administrative events, not all "
                f"website visitors.{truncation_en} Source: AUDIT_LOG."
            )

        return (
            f"Audit kayıtlarına göre {len(ip_items)} farklı IP adresi "
            f"görüldü: {values}. Bunlar tüm site ziyaretçileri değil, "
            f"denetlenen yönetim olaylarıyla ilişkili IP adresleridir."
            f"{truncation_tr} Kaynak: AUDIT_LOG."
        )

    if plan.intent == QueryIntent.AUTH_LOGIN_COUNT:
        requested_actions = set(plan.actions)

        if requested_actions == {"LOGIN_FAILURE"}:
            count = login_failure
            tr_label = "başarısız yönetici girişi"
            en_label = "failed administrative login events"
        elif requested_actions == {"LOGIN_BLOCKED"}:
            count = login_blocked
            tr_label = "engellenen yönetici girişi"
            en_label = "blocked administrative login events"
        else:
            count = login_success
            tr_label = "başarılı yönetici girişi"
            en_label = "successful administrative login events"

        if response_language == "en":
            return (
                f"The selected period contains {count} {en_label}."
                f"{truncation_en} Source: AUDIT_LOG."
            )

        return (
            f"Seçilen dönemde {count} {tr_label} kaydı bulundu."
            f"{truncation_tr} Kaynak: AUDIT_LOG."
        )

    if plan.intent == QueryIntent.REQUEST_COUNT:
        status_counts = (
            operational_summary.get(
                "statusCodeCounts"
            )
            or {}
        )

        status_text = ", ".join(
            f"{key}: {value}"
            for key, value in sorted(
                status_counts.items()
            )
        )

        if response_language == "en":
            return (
                f"The selected period contains {http_requests} HTTP "
                f"request records. Status codes: "
                f"{status_text or 'not available'}."
                f"{truncation_en} Source: RUNTIME_LOG."
            )

        return (
            f"Seçilen dönemde {http_requests} HTTP istek kaydı bulundu. "
            f"Durum kodları: {status_text or 'mevcut değil'}."
            f"{truncation_tr} Kaynak: RUNTIME_LOG."
        )

    if plan.intent == QueryIntent.REQUEST_ENDPOINT_SUMMARY:
        paths = (
            operational_summary.get("topPaths")
            or []
        )

        if not paths:
            if response_language == "en":
                return (
                    "No endpoint/path record was found in the selected "
                    "period. Source: RUNTIME_LOG."
                )

            return (
                "Seçilen dönemde endpoint/path kaydı bulunamadı. "
                "Kaynak: RUNTIME_LOG."
            )

        path_text = ", ".join(
            f"{item.get('path')} "
            f"({item.get('count')} request)"
            for item in paths
        )

        if response_language == "en":
            return (
                f"Most frequently recorded endpoints: {path_text}."
                f"{truncation_en} Source: RUNTIME_LOG."
            )

        return (
            f"En sık kaydedilen endpointler: {path_text}."
            f"{truncation_tr} Kaynak: RUNTIME_LOG."
        )

    return None


def fallback_answer(
    evidence: list[EvidenceResponse],
    filtered_total: int | None,
    response_language: str,
    operational_summary: dict[str, Any] | None = None,
    plan: QueryPlan | None = None,
) -> str:
    if not evidence:
        if (
            operational_summary is not None
            and plan is not None
        ):
            total_events = int(
                operational_summary.get(
                    "totalEvents",
                    0,
                )
            )

            source_types = (
                ", ".join(plan.source_types)
                or "UNKNOWN"
            )

            if (
                plan.intent.value
                == "RECURRING_ERROR_SUMMARY"
            ):
                if response_language == "en":
                    return (
                        "No ERROR record was found in the requested "
                        "period; therefore no recurring error type was "
                        "found. "
                        f"Total matching records: {total_events}. "
                        f"Source types: {source_types}."
                    )

                return (
                    "İstenen dönemde ERROR seviyesinde kayıt "
                    "bulunmadı; bu nedenle tekrar eden hata türü de "
                    "bulunmadı. "
                    f"Eşleşen toplam kayıt: {total_events}. "
                    f"Kaynak türleri: {source_types}."
                )

            if plan.retrieval_mode in {
                RetrievalMode.AGGREGATE,
                RetrievalMode.FILTERED_LIST,
            }:
                if response_language == "en":
                    return (
                        "No operational event matched the requested "
                        "period and filters. "
                        f"Total matching records: {total_events}. "
                        f"Source types: {source_types}."
                    )

                return (
                    "İstenen dönem ve filtrelerle eşleşen operasyon "
                    "olayı bulunmadı. "
                    f"Eşleşen toplam kayıt: {total_events}. "
                    f"Kaynak türleri: {source_types}."
                )

        if response_language == "en":
            return "No operational log matched the question."

        return "Soruyla eşleşen bir operasyon logu bulunamadı."

    total = (
        filtered_total
        if filtered_total is not None
        else len(evidence)
    )

    source_types = sorted(
        {item.sourceType for item in evidence}
    )

    if plan is not None and plan.exact_terms:
        exact_text = ", ".join(plan.exact_terms)

        if response_language == "en":
            return (
                f"Evidence directly matching {exact_text} was found in "
                f"{len(evidence)} operational log records. "
                f"Source types: {', '.join(source_types)}."
            )

        return (
            f"{exact_text} ile doğrudan eşleşen kanıt "
            f"{len(evidence)} operasyon logunda bulundu. "
            f"Kaynak türleri: {', '.join(source_types)}."
        )

    if operational_summary is not None:
        errors = int(
            operational_summary.get("errorCount", 0)
        )
        warnings = int(
            operational_summary.get("warningCount", 0)
        )
        created = int(
            operational_summary.get("createdCount", 0)
        )
        updated = int(
            operational_summary.get("updatedCount", 0)
        )
        deleted = int(
            operational_summary.get("deletedCount", 0)
        )

        if response_language == "en":
            return (
                f"{total} operational events matched the requested period. "
                f"Errors: {errors}; warnings: {warnings}; "
                f"created: {created}; updated: {updated}; deleted: {deleted}. "
                f"Source types: {', '.join(source_types)}."
            )

        return (
            f"İstenen dönemle eşleşen {total} operasyon olayı bulundu. "
            f"Hata: {errors}; uyarı: {warnings}; "
            f"oluşturma: {created}; güncelleme: {updated}; silme: {deleted}. "
            f"Kaynak türleri: {', '.join(source_types)}."
        )

    if response_language == "en":
        return (
            f"{total} records matched the filters. "
            f"The {len(evidence)} most relevant records were reviewed. "
            f"Source types: {', '.join(source_types)}."
        )

    return (
        f"Filtrelerle eşleşen {total} kayıt bulundu. "
        f"Rapor için en ilgili {len(evidence)} kayıt incelendi. "
        f"Kaynak türleri: {', '.join(source_types)}."
    )


