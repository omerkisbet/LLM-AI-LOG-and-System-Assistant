    )


def resolve_response_language(plan: QueryPlan) -> str:
    return "en" if plan.detected_language == "en" else "tr"


def compact_evidence_for_prompt(
    evidence: list[EvidenceResponse],
) -> list[dict[str, Any]]:
    payload: list[dict[str, Any]] = []

    for item in evidence[:PROMPT_EVIDENCE_LIMIT]:
        value = item.model_dump(
            mode="json",
            exclude_none=True,
        )
        value["description"] = str(
            value.get("description") or ""
        )[:PROMPT_DESCRIPTION_LIMIT]
        payload.append(value)

    return payload


def compact_summary_for_prompt(
    operational_summary: dict[str, Any] | None,
) -> dict[str, Any] | None:
    if operational_summary is None:
        return None

    compact = dict(operational_summary)
    compact.pop("latestEvents", None)
    compact.pop("latestErrors", None)
    compact.pop("latestWarnings", None)

    # Operational summary tarihleri UTC olarak saklanır.
    # Prompt'a kullanıcı tarafından seçilen yerel saat dilimiyle aktarılır.
    timezone_name = str(
        compact.get("timezone")
        or "Europe/Istanbul"
    )
    local_timezone = resolve_timezone(
        timezone_name
    )

    utc_period = dict(
        compact.get("period")
        or {}
    )

    local_period: dict[str, Any] = {
        "timezone": timezone_name,
    }

    for utc_key, local_key in (
        ("fromUtc", "fromLocal"),
        ("toUtc", "toLocal"),
    ):
        raw_value = utc_period.get(utc_key)

        if not raw_value:
            local_period[local_key] = None
            continue

        parsed = datetime.fromisoformat(
            str(raw_value).replace(
                "Z",
                "+00:00",
            )
        )

        local_period[local_key] = (
            parsed
            .astimezone(local_timezone)
            .isoformat()
        )

    compact["period"] = local_period

    return compact


def evidence_text(evidence: EvidenceResponse) -> str:
    values = (
        evidence.description,
        evidence.recordId,
        evidence.pointId,
        evidence.requestId,
        evidence.entityId,
        evidence.entityType,
        evidence.action,
        evidence.level,
        evidence.sourceType,
    )

    return " ".join(
        str(value)
        for value in values
        if value is not None
    ).casefold()


def missing_exact_terms(
    plan: QueryPlan,
    evidence: list[EvidenceResponse],
) -> list[str]:
    if not plan.exact_terms:
        return []

    corpus = " ".join(
        evidence_text(item)
        for item in evidence
    )

    return [
        term
        for term in plan.exact_terms
        if term.casefold() not in corpus
    ]


def exact_term_not_found_answer(
    missing_terms: list[str],
    response_language: str,
) -> str:
    joined = ", ".join(missing_terms)

    if response_language == "en":
        return (
            "No operational log directly matching the exact term(s) "
            f"{joined} was found."
        )

    return (
        "Kesin terimlerle doğrudan eşleşen bir operasyon logu "
        f"bulunamadı: {joined}."
    )


def diagnostic_prompt_corpus(
    chat_request: ChatRequest,
    evidence: list[EvidenceResponse],
) -> str:
    values = [chat_request.message]

    for item in evidence:
        values.extend(
            [
                item.description,
                item.level,
                item.sourceType,
                item.action,
                item.entityType,
                item.entityId,
                item.requestId,
            ]
        )

    return " ".join(
        str(value)
        for value in values
        if value is not None
    ).casefold()


def diagnostic_prompt_profile(
    chat_request: ChatRequest,
    evidence: list[EvidenceResponse],
    plan: QueryPlan | None = None,
    operational_summary: dict[str, Any] | None = None,
) -> tuple[str, str, str]:
    """Return (mode, category, bilingual guidance key).

    The classifier is deliberately deterministic and narrow. It only selects
    a compact prompt profile; it does not alter retrieval or evidence.
    """

    # Aggregate sorgularında tek bir evidence kaydının hata kategorisi,
    # toplu kullanıcı niyetinin önüne geçmemelidir.
    if plan is not None and operational_summary is not None:
        if plan.intent.value == "RECURRING_ERROR_SUMMARY":
            return (
                "recurrence",
                "recurring_error_summary",
                "recurring_error_summary",
            )

        if plan.intent.value == "DAILY_SUMMARY":
            return (
                "aggregate",
                "operational_summary",
                "operational_summary",
            )

    question = chat_request.message.casefold()
    corpus = diagnostic_prompt_corpus(
        chat_request,
        evidence,
    )

    levels = {
        str(item.level or "").upper()
        for item in evidence
    }

    asks_normality = any(
        term in question
        for term in (
            "hata mı",
            "normal başlangıç",
            "normal bilgi",
            "is this an error",
            "normal startup",
            "normal information",
        )
    )

    if (
        asks_normality
        and levels
        and levels.isdisjoint({"ERROR", "WARN"})
    ):
        return "normal", "normal_event", "normal_event"

    exact_permission_question = any(
        term in question
        for term in (
            "hangi rol",
            "hangi izin",
            "eksik rol",
            "eksik izin",
            "kesin belirlenebilir mi",
            "which role",
            "which permission",
            "missing role",
            "missing permission",
            "identified conclusively",
            "conclusively from this log",
        )
    )

    access_log_only_502 = (
        "502" in corpus
        and len(evidence) <= 2
        and not any(
            marker in corpus
            for marker in (
                "exception",
                "connection refused",
                "connect() failed",
                "read timed out",
                "timeout exception",
                "broken pipe",
            )
        )
    )

    asks_exact_root_cause = any(
        term in question
        for term in (
            "kesin kök neden",
            "tek erişim kaydından",
            "exact root cause",
            "single access record",
            "determined from this single",
        )
    )

    access_log_only_503 = (
        "503" in corpus
        and len(evidence) <= 2
        and asks_exact_root_cause
        and any(
            marker in corpus
            for marker in (
                "nginx.access",
                "access log",
                "access entry",
                "erişim kaydı",
                "no upstream error detail",
            )
        )
        and not any(
            marker in corpus
            for marker in (
                "exception",
                "connection refused",
                "connect() failed",
                "read timed out",
                "timeout exception",
                "maintenance mode enabled",
                "capacity exhausted",
                "health check failed",
            )
        )
    )

    if exact_permission_question:
        return (
            "uncertain",
            "authorization_detail_unknown",
            "authorization_detail_unknown",
        )

    if access_log_only_502:
        return (
            "uncertain",
            "upstream_502_unknown",
            "upstream_502_unknown",
        )

    if access_log_only_503:
        return (
            "uncertain",
            "http_503_unknown",
            "http_503_unknown",
        )

    # Response-stream diagnostics require conjunction-based checks.
    # This prevents generic HTTP/JSON advice when the evidence already
    # establishes a Broken pipe or an SSE converter mismatch.
    if "broken pipe" in corpus:
        return (
            "established",
            "broken_pipe_response_write",
            "broken_pipe_response_write",
        )

    if (
        "text/event-stream" in corpus
        and any(
            marker in corpus
            for marker in (
                "no converter",
                "httpmessagenotwritableexception",
                "linkedhashmap",
            )
        )
    ):
        return (
            "established",
            "sse_message_converter_mismatch",
            "sse_message_converter_mismatch",
        )

    category_checks = (
        (
            "security_committed_response",
            (
                "response already committed",
                "already committed",
                "authorizationdeniedexception",
            ),
        ),
        (
            "missing_static_resource",
            (
                "noresourcefoundexception",
                "no static resource",
                "statik kaynak",
                "/favicon.ico",
                "/images/",
            ),
        ),
        (
            "mongodb_authentication",
            (
                "scram-sha-256",
                "authentication failed",
                "mongodb rejected",
            ),
        ),
        (
            "mongodb_query_timeout",
            (
                "mongoexecutiontimeoutexception",
                "maxtimems",
                "exceeded time limit",
            ),
        ),
        (
            "connection_pool_exhaustion",
            (
                "hikaripool",
                "connection is not available",
                "waiting=",
            ),
        ),
        (
            "docker_port_conflict",
            (
                "bind for 0.0.0.0:",
                "address already in use",
                "port is already allocated",
            ),
        ),
        (
            "filesystem_permission",
            (
                "accessdeniedexception",
                "permission denied",
                "/app/uploads",
            ),
        ),
        (
            "connection_refused",
            (
                "connection refused",
                "connect() failed (111",
            ),
        ),
        (
            "disk_full",
            (
                "enospc",
                "no space left on device",
            ),
        ),
        (
            "cpu_throttling",
            (
                "cpu throttling",
                "throttled",
                "cpu limit",
            ),
        ),
        (
            "expired_certificate",
            (
                "sslhandshakeexception",
                "certificate expired",
                "notafter:",
            ),
        ),
        (
            "connection_reset",
            (
                "connection reset by peer",
                "connection reset",
            ),
        ),
        (
            "read_timeout",
            (
                "read timed out",
                "read timeout",
            ),
        ),
        (
            "cors_rejection",
            (
                "cors",
                "preflight",
                "allowed origins",
            ),
        ),
    )

    for category, markers in category_checks:
        if any(marker in corpus for marker in markers):
            return "established", category, category

    return "established", "generic", "generic"


